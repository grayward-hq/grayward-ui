# ─────────────────────────────────────────────────────────────────────────────
# Example environment file. Copy to .env.local and fill in real values.
#
#   cp .env.example .env.local
#
# NOTE: every NEXT_PUBLIC_* value is inlined into the browser bundle at BUILD
# time. Changing one in the hosting dashboard requires a rebuild/redeploy to
# take effect, and the value is publicly visible — never put a secret here.
# ─────────────────────────────────────────────────────────────────────────────


# ── Feature flags ────────────────────────────────────────────────────────────
# Controls whether a button renders. Accepts true or false.
# Quotes are optional and stripped either way, so true and "true" both work.
# Anything other than "true" is treated as false. If a var is unset, the
# default shown in the comment applies.

# Header "Login" button. Default when unset: false
NEXT_PUBLIC_SHOW_LOGIN_BUTTON=false

# Header / mobile-menu "Join Waitlist" button. Default when unset: false
NEXT_PUBLIC_SHOW_JOIN_WAITLIST_BUTTON=false

# "Join Waitlist" CTA in the waitlist page hero. Default when unset: true
NEXT_PUBLIC_SHOW_WAITLIST_HERO_CTA=true


# ── Application ──────────────────────────────────────────────────────────────

# Base URL of the backend API, no trailing slash
NEXT_PUBLIC_API_URL=https://api.example.com

# Public origin of this site, used for canonical and OG URLs
NEXT_PUBLIC_APP_URL=https://example.com

NEXT_PUBLIC_APP_NAME=VulnWatch AI


# ── Third party ──────────────────────────────────────────────────────────────

# Google OAuth client ID (public by design)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# GitHub App installation URL. Exposed to the client via the `env` block in
# next.config.ts — note the double underscore, and that it is case-sensitive.
GithubApp__InstallationUrl=https://github.com/apps/your-app/installations/new
